{
	"name": "@foopis23/kith",
	"version": "0.1.0",
	"description": "Terminal UI for running persistent Dockerized Minecraft servers",
	"license": "UNLICENSED",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"kith": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"start": "bun run src/index.tsx",
		"build": "tsc",
		"prepublishOnly": "bun run build",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"test": "bun test",
		"test:integration": "KITH_INTEGRATION_TEST=1 bun test --preload ./test/setup.ts test/*.integration.test.ts"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.102.8",
		"chalk": "^6.0.0",
		"docker-compose": "^1.4.2",
		"fuse.js": "^7.5.0",
		"ink": "^7.1.1",
		"ink-big-text": "^2.0.0",
		"ink-select-input": "^6.2.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^6.0.0",
		"pino": "^10.3.1",
		"qs": "^6.16.0",
		"react": "^19.2.8",
		"react-router": "^8.3.1",
		"string-width": "^8.2.2",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/bun": "latest",
		"@types/qs": "^6.15.1",
		"@types/react": "^19.2.18",
		"pino-pretty": "^13.1.3",
		"typescript": "^7"
	}
}