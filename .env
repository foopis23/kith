# Dev-only defaults. Safe, shared values only — personal overrides and
# secrets (backup passwords, cloud credentials) belong in .env.local,
# which is gitignored and takes precedence.
#
# Paths are relative to the working directory, so run kith from the
# repo root (e.g. `bun run start`) for these to land in ./data.
KITH_SERVERS_DIR=./data/servers
KITH_LOG_DIR=./data/logs
KITH_CACHE_DIR=./data/cache
KITH_TMP_FILE_DIR=./data/tmp
